{
  "name": "edgeforms",
  "version": "1.0.0",
  "private": true,
  "description": "RegisterMySite EdgeForms — Formspree-style form backend on the Cloudflare network",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply edgeforms --local",
    "db:migrate:remote": "wrangler d1 migrations apply edgeforms --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
